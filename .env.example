# Copy to .env and fill in:  cp .env.example .env

# Free Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use a different model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-latest

# Gmail account that sends the digest
EMAIL_ADDRESS=you@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password). Spaces are fine.
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where to send the digest (comma-separate multiple addresses)
EMAIL_TO=you@gmail.com
